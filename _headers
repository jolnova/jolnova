# Cloudflare Pages basliklar dosyasi
# ---------------------------------------------------------------
# SORUN: site guncellendikten sonra ziyaretci (ve biz) eski surumu
# goruyor, Ctrl+F5 gerekiyordu.
#
# NEDEN: CSS/JS adreslerinde zaten icerik damgasi var (?v=442c6ac9af)
# ama HTML'IN KENDISI onbellege aliniyordu. Tarayici eski HTML'i
# sunuyor, o HTML de ESKI damgayi istiyor -> yeni dosyalar hic
# indirilmiyor. Yani damgalama tek basina yetmiyor; damgayi TASIYAN
# belgenin taze olmasi sart.
#
# COZUM: HTML her seferinde dogrulanir (ucuz: degismediyse 304 doner,
# icerik tekrar inmez), damgali varliklar ise sonsuza kadar saklanir.
# ---------------------------------------------------------------

# Varsayilan: her istekte sunucuya sor. 304 yaniti bant genisligi
# harcamaz, ama guncelleme ANINDA gorunur.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Damgali varliklar: adres ?v=<icerik-ozeti> tasiyor. Icerik degisince
# damga degisir, adres degisir, tarayici yeniden indirir. Bu yuzden
# dosyanin kendisi bir yil saklanabilir.
/site.css
  Cache-Control: public, max-age=31536000, immutable
/lang.js
  Cache-Control: public, max-age=31536000, immutable
/lang-de.js
  Cache-Control: public, max-age=31536000, immutable
/lang-fr.js
  Cache-Control: public, max-age=31536000, immutable
/lang-es.js
  Cache-Control: public, max-age=31536000, immutable
/user.js
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# ⚠️ version.json UZUN SAKLANAMAZ: guncelleyici bunu okuyor.
# Onbellekte kalirsa yeni surum cikmis olsa bile kullanicinin
# uygulamasi gunlerce "guncel" der. Kisa tutuluyor.
/version.json
  Cache-Control: public, max-age=60, must-revalidate

# Site haritasi ve robots: arama motoru zaten seyrek okur.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
