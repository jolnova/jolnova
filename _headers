# Cloudflare Pages basliklar dosyasi
# ---------------------------------------------------------------
# SORUN: site guncellendikten sonra eski surum goruluyordu, Ctrl+F5
# gerekiyordu. CSS/JS adreslerinde icerik damgasi (?v=...) zaten vardi
# ama HTML'IN KENDISI onbellekteydi; eski HTML eski damgayi istiyor,
# yeni dosyalar hic indirilmiyordu. Damgayi TASIYAN belge taze olmali.
#
# ⚠️ KURALLAR BIRIKIR, EZMEZ.
# Ilk surumde /* altina Cache-Control yazilmisti ve varlik kurallariyla
# BIRLESIP celisen direktifler uretiyordu:
#     site.css -> "max-age=31536000, must-revalidate, immutable"
#     version.json -> "max-age=0, ..., max-age=60, ..."
# Ayni baslikta iki max-age tanimsiz davranistir. Bu yuzden /* altinda
# ARTIK Cache-Control YOK; oraya yalnizca guvenlik basliklari kaldi.
# HTML icin Cloudflare Pages'in kendi varsayilani (revalidate) gecerli.
# ---------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Damgali varliklar: adres ?v=<icerik-ozeti> tasir. Icerik degisince
# damga degisir, adres degisir, tarayici yeniden indirir. Dosyanin
# kendisi bu yuzden bir yil saklanabilir.
/site.css
  Cache-Control: public, max-age=31536000, immutable
/lang.js
  Cache-Control: public, max-age=31536000, immutable
/lang-de.js
  Cache-Control: public, max-age=31536000, immutable
/lang-fr.js
  Cache-Control: public, max-age=31536000, immutable
/lang-es.js
  Cache-Control: public, max-age=31536000, immutable
/user.js
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# ⚠️ version.json UZUN SAKLANAMAZ: guncelleyici bunu okuyor. Onbellekte
# kalirsa yeni surum ciksa bile kullanicinin uygulamasi "guncel" der.
/version.json
  Cache-Control: public, max-age=60

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
